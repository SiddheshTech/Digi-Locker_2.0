{
  "name": "digilocker-server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "compile": "npx hardhat --config hardhat.config.cjs compile",
    "deploy:local": "node scripts/deploy_simple.js",
    "deploy:sepolia": "npx hardhat --config hardhat.config.cjs run scripts/deploy.js --network sepolia",
    "chain": "npx hardhat --config hardhat.config.cjs node"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "csv-parse": "^5.5.6",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.5.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.6.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "hardhat": "^3.1.9",
    "nodemon": "^3.1.13"
  }
}