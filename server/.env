# Environment Configuration
# Copy this to .env and fill in your values

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
BASE_URL=http://localhost:5000

# ── Blockchain ───────────────────────────────────────────────────────────────
# Leave these empty to run in mock/demo mode (no real transactions)

# Your Ethereum private key (for server-side signing)
# WARNING: Never commit real private keys! Use a test key only.
PRIVATE_KEY=

# RPC endpoint (e.g. Infura Sepolia, Alchemy, or local Hardhat)
# Example: https://sepolia.infura.io/v3/YOUR_KEY
# Example: http://127.0.0.1:8545  (Hardhat local node)
RPC_URL=

# Deployed CredentialRegistry contract address
CONTRACT_ADDRESS=
