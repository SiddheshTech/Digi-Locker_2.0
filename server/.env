# Environment Configuration
# Copy this to .env and fill in your values

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Blockchain ───────────────────────────────────────────────────────────────
# Hardhat local node — run: npm run chain  (in a separate terminal)
# This uses Hardhat Account #0 (public test key — safe for demo only!)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Local Hardhat RPC (when running: npx hardhat node)
RPC_URL=http://127.0.0.1:8545

# Paste the address printed by: npm run deploy:local
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Receipt auditor signature secret (optional)
# AUDITOR_SECRET=your-secret
